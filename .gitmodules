[submodule ".config/nvim"]
	path = .config/nvim
	url = https://github.com/rolandwarburton/nvim.conf.git
	# url = git@github.com:rolandwarburton/nvim.conf
[submodule ".config/shell/zsh/plugins/zsh-syntax-highlighting"]
	path = .config/shell/zsh/plugins/zsh-syntax-highlighting
	url = git@github.com:zsh-users/zsh-syntax-highlighting.git
[submodule ".config/shell/zsh/plugins/zsh-autosuggestions"]
	path = .config/shell/zsh/plugins/zsh-autosuggestions
	url = git@github.com:zsh-users/zsh-autosuggestions.git
[submodule ".config/shell/zsh/plugins/forgit"]
	path = .config/shell/zsh/plugins/forgit
	url = git@github.com:wfxr/forgit.git
